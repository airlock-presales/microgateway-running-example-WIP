{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["kustomize", "helmv3", "helm-values", "kubernetes"],
  "kustomize": {
    "managerFilePatterns": ["/(^|/)[Kk]ustomization\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)values(\\.[^/]+)?\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)(k8s|manifests|deployments)/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/mariadb", "docker.io/library/mariadb", "mariadb"],
      "matchFileNames": ["manifests/mcp/apps/database/statefulset.yaml"],
      "allowedVersions": "/^11\\.4\\.[0-9]+$/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/airlock/iam"],
      "enabled": false
    }
  ]
}
